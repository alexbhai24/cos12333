// Deployed: 2026-07-29
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- HELPER FUNCTIONS ---

    function signedIn() {
      return request.auth != null;
    }

    function isMember() {
      return signedIn();
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // Admin helper: checks custom claims OR fixed admin email rajanandalex1@gmail.com
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == "admin" ||
        request.auth.token.email == "rajanandalex1@gmail.com"
      );
    }

    function isTeacher() {
      return isMember() && (request.auth.token.role == "teacher" || isAdmin());
    }

    function isStudent() {
      return isMember() && request.auth.token.role == "student";
    }

    function validGrade(grade) {
      return grade in [
        "class_6", "class_7", "class_8",
        "class_9", "class_10",
        "pcb", "pam", "skill", "dropper"
      ];
    }

    function canViewGrade(grade) {
      return true;
    }

    function canManageGrade(grade) {
      return true;
    }

    function canAccessRoom(roomId) {
      return signedIn();
    }

    /*
      =====================================================
      USER PROFILE DATA: /users/{userId}
      =====================================================
    */
    match /users/{userId} {
      allow read: if signedIn();
      allow create, update: if signedIn();
      allow delete: if false;

      /*
        =====================================================
        SAVED VIDEO HISTORY: /users/{userId}/savedVideos/{videoId}
        =====================================================
      */
      match /savedVideos/{videoId} {
        allow read, write, delete: if isSelf(userId);
      }

      match /{privateDocument=**} {
        allow read, write: if isSelf(userId);
      }
    }

    /*
      =====================================================
      PUBLIC PROFILES: /publicProfiles/{userId}
      =====================================================
    */
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update, delete: if signedIn();
    }

    /*
      =====================================================
      VIDEOS COLLECTION: /videos/{videoId}
      =====================================================
      - All users can read published videos.
      - Authenticated users (admins & teachers) can create videos.
    */
    match /videos/{videoId} {
      allow read: if true;
      allow create: if signedIn();
      allow update, delete: if signedIn() && (
        isAdmin() ||
        resource.data.uploadedByUid == request.auth.uid
      );
    }

    /*
      =====================================================
      ACADEMIC CONTENT / FILES: /content/{contentId}
      =====================================================
    */
    match /content/{contentId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /questions/{questionId} {
        allow read, write: if signedIn();
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    /*
      =====================================================
      COMMUNITY POSTS: /posts/{postId}
      =====================================================
    */
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if signedIn();

      match /comments/{commentId} {
        allow read: if true;
        allow create, update, delete: if signedIn();
      }
    }

    /*
      =====================================================
      ACTIVE STUDY ROOMS: /rooms/{roomId}
      =====================================================
    */
    match /rooms/{roomId} {
      allow read: if signedIn();
      allow create, update, delete: if signedIn();

      match /messages/{messageId} {
        allow read: if signedIn();
        allow create, update, delete: if signedIn();
      }
    }

    /*
      =====================================================
      ADMIN METRICS: /adminMetrics/{metricId}
      =====================================================
    */
    match /adminMetrics/{metricId} {
      allow read: if signedIn();
      allow write: if signedIn();
    }

    /*
      =====================================================
      DEFAULT CATCH-ALL
      =====================================================
    */
    match /{document=**} {
      allow read, write: if signedIn();
    }
  }
}